{
  "name": "home-heat-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "setup:auth": "node --experimental-strip-types scripts/setup-auth.ts",
    "check:auth": "node --experimental-strip-types scripts/check-auth.ts",
    "migrate:rewards": "node --env-file=.env.local --experimental-strip-types scripts/migrate-rewards.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:document-import-ui": "playwright test --config playwright.document-import.config.ts",
    "test:auth-ui": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "three": "^0.180.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
